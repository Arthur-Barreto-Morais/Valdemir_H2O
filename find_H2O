import os
import math
import modules as m

dir = os.getcwd()

file_path = os.path.join(dir,"water_old.xyz")

lines =[]
Carbon =[]
Water = []
Water_selected = []
count = [0,0]

d_range = input("Adicione o valor de distancia máxima entre o G3dy:  " + "\n")

with open (file_path, "r") as f:
    total = int(f.readline())
    f.readline()
    lines = f.read().split("\n")
for line in lines:
	line = line.split()
	line[1:] = map(float, line[1:])
#print(total)

for line in lines:
    if line[0] == "C":
        Carbon.append(line)
        count[0] += 1
    else:
        if line[0] == "O":
            Water.append(line)
        elif line[0] == "H":
            Water.append(line)

for h2o in Water:
    if 50.0-float(d_range) < h2o[3] < 50.0+float(d_range) and h2o[0] == "O":
        h_bond = 0
        keep_h = []
        for h in Water:
            if h[0] == "H":
                bond=m.Distance(h2o[1:],h[1:])
                if bond <= 1.2:
                    h_bond += 1
                    keep_h.append(h)
        if h_bond == 2:
            Water_selected.append(h2o)
            Water_selected.extend(keep_h)
            count[1] += 3
            

write_path = os.path.join(dir,"water_new.xyz")

with open (write_path, "w") as f:
    f.write(str(count[0]+count[1])+"\n")
    f.write(f"Quantidade de moléculas de H2O {math.trunc(count[1]/3)}"+"\n")
    for carbon in Carbon:
        f.write(" ".join(map(str,carbon)) + "\n")
    for h2o in Water_selected:
        f.write(" ".join(map(str,h2o)) + "\n")

